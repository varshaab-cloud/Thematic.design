      },
      "size": {
        "$value": "{alias-typography.label.size}",
        "$type": "fontSizes"
      },
      "weight": {
        "$value": "{alias-typography.label.weight}",
        "$type": "fontWeights"
      },
      "line-height": {
        "$value": "{alias-typography.label.line-height}",
        "$type": "lineHeights"
      }
    }
