    "color": {
      "bg": {
        "$value": "{alias-color.background.tertiary}",
        "$type": "color"
      },
      "text": {
        "$value": "{alias-color.text.secondary}",
        "$type": "color"
      },
      "ring": {
        "$value": "{alias-color.background.primary}",
        "$type": "color"
      },
      "badge": {
        "bg": {
          "$value": "{alias-color.background.brand}",
          "$type": "color"
        },
        "stroke": {
          "$value": "{alias-color.background.primary}",
          "$type": "color"
        },
        "icon": {
          "$value": "{alias-color.text.inverse}",
          "$type": "color"
        }
      },
      "count": {
        "bg": {
          "$value": "{alias-color.background.tertiary}",
          "$type": "color"
        },
        "text": {
          "$value": "{alias-color.text.secondary}",
          "$type": "color"
        }
      }
    },
    "dimension": {
      "sm": {
        "$value": "{alias-spacing.stack.md}",
        "$type": "dimension"
      },
      "md": {
        "$value": "{alias-spacing.section.md}",
        "$type": "dimension"
      },
      "lg": {
        "$value": "{alias-spacing.section.lg}",
        "$type": "dimension"
      },
      "ring-width": {
        "$value": "{alias-border.width}",
        "$type": "dimension"
