        "$type": "color"
      },
      "fill-success": {
        "$value": "{alias-color.feedback.success.fg}",
        "$type": "color"
      },
      "fill-error": {
        "$value": "{alias-color.feedback.error.fg}",
        "$type": "color"
      }
    },
