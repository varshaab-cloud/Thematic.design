        "$value": "{alias-spacing.inline.sm}",
        "$type": "dimension"
      },
      "padding-y": {
        "$value": "{alias-spacing.inline.xs}",
        "$type": "dimension"
      },
      "radius": {
        "$value": "{alias-radius.sm}",
        "$type": "dimension"
      },
      "max-width": {
        "$value": "{alias-spacing.page.md}",
        "$type": "dimension"
      }
    },
    "elevation": {
      "$value": "{alias-elevation.2}",
      "$type": "boxShadow"
    },
    "typography": {
      "family": {
        "$value": "{alias-typography.helper.family}",
        "$type": "fontFamilies"
      },
      "size": {
        "$value": "{alias-typography.helper.size}",
        "$type": "fontSizes"
      },
      "weight": {
        "$value": "{alias-typography.helper.weight}",
        "$type": "fontWeights"
      },
      "line-height": {
        "$value": "{alias-typography.helper.line-height}",
        "$type": "lineHeights"
      }
    }
